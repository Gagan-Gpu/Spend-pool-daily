<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:padding="16dp">

    <TextView
        android:id="@+id/w_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SPENT TODAY"
        android:textColor="#A9A394"
        android:textSize="11sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_add"
        android:layout_width="34dp"
        android:layout_height="34dp"
        android:layout_alignParentEnd="true"
        android:background="@drawable/widget_plus_bg"
        android:gravity="center"
        android:text="+"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_amount"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/w_label"
        android:layout_marginTop="6dp"
        android:maxLines="1"
        android:text="—"
        android:textColor="#F5F1E8"
        android:textSize="34sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_sub"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/w_amount"
        android:maxLines="1"
        android:text=""
        android:textColor="#A9A394"
        android:textSize="13sp"
        android:textStyle="bold" />
</RelativeLayout>
